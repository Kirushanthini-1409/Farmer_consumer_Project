# Copy to .env for local dev. On Render, set these as environment variables.

# Path to the Firebase service-account key (local dev)…
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# …or paste the JSON itself (preferred on Render):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Browser origins allowed by CORS (add your Firebase Hosting URL).
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5500,https://YOUR-PROJECT.web.app

# Shared secret for the /ai/retrain cron endpoint (roadmap).
RETRAIN_SECRET=change-me
